# Database
DATABASE_URL=
APP_URL=http://localhost:3000

# Paystack (server-side secret + public key if you later use client-side Paystack widgets)
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Cloudinary unsigned browser upload
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional email provider (wire Brevo/Resend in src/lib/email.ts before enabling transactional email)
BREVO_API_KEY=
EMAIL_FROM=SET APART <hello@yourdomain.com>

# Admin bootstrap — used only by db:seed
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=
STAFF_ADMIN_NAME=SET APART Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SET APART Super Admin

SESSION_SECRET=replace-with-a-long-random-secret
